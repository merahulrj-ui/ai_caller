{
  "expo": {
    "name": "ai_caller",
    "slug": "ai_caller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aicaller",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.merahulrj.ai_caller",
      "intentFilters": [
        {
          "action": "DIAL",
          "category": ["DEFAULT"],
          "data": {
            "scheme": "tel"
          }
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": {
            "scheme": "tel"
          }
        }
      ],
      "permissions": [
        "READ_PHONE_STATE",
        "RECORD_AUDIO",
        "CALL_PHONE",
        "READ_CALL_LOG",
        "WRITE_CALL_LOG",
        "READ_CONTACTS",
        "ANSWER_PHONE_CALLS",
        "READ_PHONE_NUMBERS",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1bbe27c-b1d9-483f-b5aa-b6a686463464"
      }
    }
  }
}
