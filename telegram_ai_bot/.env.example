# 1. Telegram API Details (Get from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# 2. Gemini API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Optional Target Username (agar sirf ek specific person se baat karwani ho, jaise "username123". Blank chhodne par sabhi private chats me reply karega)
TARGET_USERNAME=
